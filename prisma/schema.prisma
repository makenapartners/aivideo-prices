// AI Video Pricing Tracker — data model
// Deliberately minimal (v1 scope): no pricing_history, no pricing_alerts,
// no automated fetcher tables. Add those later only once manual
// verification proves the data is worth automating.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon: use a pooled connection string for DATABASE_URL (the one with
  // "-pooler" in the host name). If you ever need a second, direct
  // (non-pooled) connection for migrations, Neon's console gives you that
  // URL too — set it as DIRECT_URL and uncomment the line below.
  // directUrl = env("DIRECT_URL")
}

enum ProviderKind {
  model_creator
  marketplace
}

enum EntryType {
  direct
  marketplace
}

enum InputType {
  text
  image
  video
}

// The full list of operations that turn out to have genuinely different
// price tables, not just a modifier on one price — confirmed across
// Luma (generate/edit/extend/reframe) and Kling (generate plus several
// adjacent products bundled onto the same pricing page). "other" exists
// for anything that doesn't fit cleanly yet, so entering real data is
// never blocked on this enum being incomplete.
enum OperationType {
  generate
  edit
  extend
  reframe
  lip_sync
  other
}

// Kling mixes per-second, per-request, and per-5-seconds billing on the
// same pricing page for different rows — this used to be implicitly
// assumed as "always per-second," which BytePlus and Kling both
// contradict.
enum BillingUnit {
  per_second
  per_video
  per_request
  per_5_seconds
}

model Provider {
  id          String   @id @default(cuid())
  name        String   @unique
  kind        ProviderKind
  websiteUrl  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modelsCreated Model[]      @relation("ModelCreator")
  priceEntries  PriceEntry[]
}

model Model {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  creator   Provider @relation("ModelCreator", fields: [creatorId], references: [id])
  creatorId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  priceEntries PriceEntry[]
}

model PriceEntry {
  id             String        @id @default(cuid())
  model          Model         @relation(fields: [modelId], references: [id])
  modelId        String
  provider       Provider      @relation(fields: [providerId], references: [id])
  providerId     String
  entryType      EntryType
  // Kept for the cases where it's actually true — Runway, xAI, and
  // Google's Veo all confirmed real linear per-second scaling. Treat
  // this as a DERIVED/display convenience for those cases, not as the
  // source of truth for every row — see totalPrice below for the
  // general case.
  pricePerSecond Float?
  // The actual source of truth for price: what a given operation
  // costs, for a given duration, in one shot — no assumption that
  // doubling the duration doubles the price. Luma's own page proves
  // that assumption false (a 10s clip is 3x a 5s clip at 720p, not 2x).
  // For per-request/per-video pricing, forDurationSeconds can be null.
  totalPrice        Float?
  forDurationSeconds Int?
  billingUnit        BillingUnit   @default(per_second)
  operationType      OperationType @default(generate)
  resolution     String?
  hasAudio       Boolean    @default(false)
  inputType      InputType?
  // Nullable, separate from checkedAt below — checkedAt is when a human
  // verified this row is accurate; validFrom/validUntil are for a
  // provider's own stated promotional window (BytePlus's pricing page
  // states exact discount expiration dates directly). A row can be
  // accurately checked today and still be describing a price that's
  // only valid until a known future date.
  validFrom      DateTime?
  validUntil     DateTime?
  sourceUrl      String     // required, always linkable
  checkedAt      DateTime   // when a human last verified this
  needsRecheck   Boolean    @default(false)
  notes          String?    // free text for honesty caveats
  // Null = this is the current, live price shown on /prices. A date =
  // this row was replaced on that date and is kept purely for history —
  // never shown publicly, but never deleted either, so future reporting
  // (price-change timelines, etc.) has real data to work with. Set this
  // instead of deleting a row when a price changes; reserve actual
  // deletion for genuine mistakes/duplicates.
  supersededAt   DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}
