# Neon connection string — use the POOLED one (host name contains "-pooler")
# Find it in the Neon console: your project > Connection Details
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# A password you make up, used to gate the /admin page and admin API routes.
# Put the same value in Netlify's environment variables.
ADMIN_SECRET="choose-a-long-random-password-here"
